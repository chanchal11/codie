# Local models (default provider).
OLLAMA_MODEL=qwen2.5-coder
OLLAMA_HOST=http://127.0.0.1:11434

# Amazon Bedrock. Used when you pass --provider bedrock or /provider bedrock.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Web search. Keys stay here. ~/.codie/config.json only stores which provider is active.
# SEARXNG_URL overrides the URL saved from the TUI.
SEARXNG_URL=http://127.0.0.1:8080
# TAVILY_API_KEY=
# OPENAI_API_KEY=
# OPENAI_SEARCH_MODEL=gpt-4.1-mini
